            "facility": "local0",
            "level": "info"
          }
        },
        "timeout": {
          "client": "50",
          "connect": "10",
          "server": "50"
        },
        "service": {
          "https-in": {
            "mode": "http",
            "listen-address": {
              "0.0.0.0": {}
            },
            "port": "443",
            "backend": "web-backend",
            "rule": {
              "10": {
                "domain-name": "app.example.com",
                "set": {
                  "backend": {
                    "backend": "web-backend"
                  }
                }
              }
            }
          }
        },
        "backend": {
          "web-backend": {
            "mode": "http",
            "balance": "round-robin",
            "http-check": {
              "method": "get",
              "uri": "/healthz",
              "expect": "status 200-399"
            },
            "server": {
              "srv1": {
                "address": "10.0.0.11",
                "port": "443",
                "check": {},
                "send-proxy-v2": {}
              }
            }
          }
        }
      }
    }
